headers, data := import csv "/test/data/test.csv"

csv_table is function(headers: string[], data: string[string][]) -> element {
  table: {
    thead: {
      tr.font-bold: {
        for header in headers {
          th: { header }
        }
      }
    }
    tbody: {
      for item in data {
        tr: {
          th.font-semibold: { item[headers[0]] }
          for field in headers[1..] {
            td: { item[field] }
          }
        }
      }
    }
  }
}

title := "CSV table demo"

html: {
  head: {
    meta(charset = "utf-8")
    title: { title }
    script(src = "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4")
  }
  body: {
    h1: { title }
    csv_table(headers, data)
  }
}
