// Simple list literal
foo: int[] = [1, 2, 3]

// Shorthand list literal
foo: int[] = [0; 1000]

// Expressions in list
foo := [1 + 3, 2 - 5, 6 * 6 + 5]

// List of lists
foo: int[][] = [
  [1, 2, 3],
  for n in [1, 2, 3] {
    n * n
  }
]

// Simple list access
foo[1]

// Multiple list access
foo[0, 2, 5 + bar]

// List slices: index by a range expression
foo[0..5]

// Incomplete range expressions are allowed
foo[2..]
foo[..15]
foo[..]

// Multi-slicing
foo[..8, 10..15, 24..]
