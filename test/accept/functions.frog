square is function(x: float) -> float {
  y: float = 5
  y = x
  x * y
}

multiply is function(x: int, y: int) -> int { x * y }

square(4)
square(0.5)

for x in [1, 2, 3, 4, 5] {
  square(x)
}

with_defaults is function(s: string = "hello", n: int = 2 * 3) -> string {
  s * n
}

with_defaults()
with_defaults(n = 2)
with_defaults("hi")
with_defaults("hi", 3)
with_defaults(n = 2, s = "abc")
