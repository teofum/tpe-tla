foo: float = 5
bar := 4

x := foo + bar

bar = 2

array := [1, 2, 3]

// Constant
y ::= array[bar]

array[bar] = 5

z := array[bar]

x
y
z
if x < z { 88 }                       // Should be skipped
if x < z { 88 } else { 99 }           // Should be 99
if x >= y + z { array[0] } else { 5 } // Should be 1
