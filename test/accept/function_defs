// Function definition
squares is function(ns: int[]) -> int[] {
  for n in ns { n * n }
}

// No parameters
hello is function() -> string { "Hellow" }

// Parameter list can be omitted entirely if function takes no params
hello2 is function -> string { "Hellow" }

// Nested function definition
squares2 is function(ns: int[]) -> int[] {
  for n in ns { square(n) }
  square is function(n: int) -> int { n * n }
}
