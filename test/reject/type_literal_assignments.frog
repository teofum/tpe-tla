x: int = 5        // OK: type matches exactly

y: float = x      // OK: integers can be upgraded to float

x = 5.6           // Type error: float can't be assigned to integer

y = "Hello"       // Obvious type error!

foo := [5, 8]     // Inferred short tuple type

bar: int[] = foo  // OK: can be assigned

foo = bar         // But not the other way around: [int, int] is more specific
